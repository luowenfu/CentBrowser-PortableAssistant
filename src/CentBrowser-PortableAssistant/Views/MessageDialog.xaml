<Window x:Class="CentBrowser_PortableAssistant.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DialogWindow" Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}">
    <StackPanel Margin="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WarnIcon" Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20"
                       Foreground="{StaticResource KraftEdge}" Margin="0,1,12,0" VerticalAlignment="Top"
                       Visibility="Collapsed" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="MessageText" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                <TextBlock x:Name="NoteText" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="80" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="8,0,0,0" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
