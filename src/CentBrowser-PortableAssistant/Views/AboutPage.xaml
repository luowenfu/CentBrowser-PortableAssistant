<UserControl x:Class="CentBrowser_PortableAssistant.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BrandButton" TargetType="Button">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrandIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{StaticResource Text2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 只读文本框，看起来像正文，但可以选中复制 -->
        <Style x:Key="CopyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="CaretBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cent Browser 便携助手" Style="{StaticResource PageTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="VersionText" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource BrandButton}" Margin="12,0,0,0"
                                    ToolTip="打开 GitHub 项目主页" Click="OnOpenGitHub">
                                <Path Style="{StaticResource BrandIcon}"
                                      Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
                            </Button>
                            <Button Style="{StaticResource BrandButton}" Margin="8,0,0,0"
                                    ToolTip="打开 Gitee 项目主页" Click="OnOpenGitee">
                                <Path Style="{StaticResource BrandIcon}"
                                      Data="M11.984 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.016 0zm6.09 5.333c.328 0 .593.266.592.593v1.482a.594.594 0 0 1-.593.592H9.777c-.982 0-1.778.796-1.778 1.778v5.63c0 .327.266.592.593.592h5.63c.982 0 1.778-.796 1.778-1.778v-.296a.593.593 0 0 0-.592-.593h-4.15a.592.592 0 0 1-.592-.592v-1.482a.593.593 0 0 1 .593-.592h6.815c.327 0 .593.265.593.592v3.408a4 4 0 0 1-4 4H5.926a.593.593 0 0 1-.593-.593V9.778a4.444 4.444 0 0 1 4.445-4.444h8.296Z" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="能做什么" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />
                <TextBox Style="{StaticResource CopyText}"
                         Text="把 Cent Browser 连同选中用户的书签、历史、设置和扩展，打成一个带密码的压缩包或自解压 exe，送到 SMB、WebDAV、FTP 或本地文件夹。换一台电脑下载下来，输入密码解压，就能直接用。" />
                <TextBox Style="{StaticResource CopyText}" Margin="0,8,0,0"
                         Text="密码、Cookie、缓存和自动填充不会带走。打开“开机启动”后开机自启动并常驻托盘。再打开“自动备份”，关掉浏览器就自动备份，按设定的频率进行，勾选的用户数据没变化就跳过。" />
                <TextBox Style="{StaticResource CopyText}" Margin="0,8,0,0"
                         Text="也能当瘦身工具用：缓存这些累赘都留在原地，包一下子就轻了 ～(´▽｀)" />

                <TextBlock Text="数据保存在哪" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="打开" Click="OnOpenConfig" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="设置和备份记录" />
                                <TextBox x:Name="ConfigPath" Style="{StaticResource CopyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="打开" Click="OnOpenPending" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="待上传的文件" />
                                <TextBox x:Name="PendingPath" Style="{StaticResource CopyText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <TextBox Style="{StaticResource CopyText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                             Text="压缩由 7-Zip 提供，免费开源" />
                    <Button Style="{StaticResource QuietButton}" Content="查看许可" Margin="4,0,0,0" Click="OnOpenLicense" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CoffeeButton" Content="请作者喝咖啡" Click="OnCoffee" VerticalAlignment="Center" />
            <Popup x:Name="CoffeePopup" PlacementTarget="{Binding ElementName=CoffeeButton}" Placement="Top"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="12" Padding="16" Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <Image Source="pack://application:,,,/Assets/donate-wechat.jpg" Width="320" Height="320"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="微信扫码" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,6,0,0" Text="觉得有用，可以请作者一杯咖啡" />
                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,2,0,0" Text="自愿，不影响使用" />
                    </StackPanel>
                </Border>
            </Popup>
            <Button Content="重置 / 卸载" Click="OnReset" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
