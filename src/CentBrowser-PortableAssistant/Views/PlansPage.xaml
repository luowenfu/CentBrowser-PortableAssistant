<UserControl x:Class="CentBrowser_PortableAssistant.Views.PlansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CentBrowser_PortableAssistant.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <v:PositiveWidthConverter x:Key="PositiveWidth" />
        <v:EnumMatchConverter x:Key="EnumMatch" />

        <DataTemplate x:Key="CheckRow">
            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,10">
                <DockPanel>
                    <!-- 打不开的类型不显示按钮，但藏起来仍占位，类型才能上下对齐 -->
                    <Button DockPanel.Dock="Right" Content="打开" ToolTip="{Binding Tip}" Click="OnOpenTarget"
                            Margin="4,0,8,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Height" Value="20" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="FontSize" Value="11" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Mono}"
                               Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Tip}" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DockPanel>
            </CheckBox>
        </DataTemplate>

        <Style x:Key="ItemHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="24,2,0,12" />
        </Style>
        <!-- 嵌在灰槽里的切换块。选中用和主按钮一样的强调蓝 -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <!-- 字和左侧标题一样。悬停时跟顶栏「关于」一样有底 -->
        <Style x:Key="LabelButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
        </Style>
        <!-- 没字时不占高度，否则旁边的按钮会对着空行居中 -->
        <Style x:Key="TagMessage" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Perforation" TargetType="Line">
            <Setter Property="Y1" Value="0" />
            <Setter Property="Y2" Value="1" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Stroke" Value="{StaticResource AccentHover}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4 3" />
            <Setter Property="Margin" Value="18,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 方案切换 -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="方案选择" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ListBox x:Name="PlanTabs" Style="{StaticResource PlainList}" SelectionChanged="OnPlanSelected" MouseDoubleClick="OnTabDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="修改名称" Click="OnRenameMenu" />
                        <MenuItem Header="复制方案" Click="OnCopyPlan" />
                        <Separator />
                        <MenuItem Header="删除方案" Click="OnDeletePlan" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock x:Name="Label" Text="{Binding Name}" MaxWidth="120" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="双击修改名称，右键更多" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="RenameBox" Visibility="Collapsed" MinWidth="120" MaxWidth="240" Height="26" Margin="-8,0"
                                     Text="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnRenameKey" LostKeyboardFocus="OnRenameLostFocus" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Style="{StaticResource QuietButton}" Click="OnNewPlan" HorizontalAlignment="Left" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                    <TextBlock Text="新建方案" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- 五步 -->
        <Grid Grid.Row="1" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="312" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="332" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <HeaderedContentControl Style="{StaticResource StepCard}" Tag="1">
                    <HeaderedContentControl.Header>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BrowserMode}" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="浏览器" />
                        </DockPanel>
                    </HeaderedContentControl.Header>
                    <v:BrowserCard x:Name="Browser" />
                </HeaderedContentControl>

                <HeaderedContentControl Grid.Row="2" Style="{StaticResource StepCard}" Tag="2" x:Name="ProfilesStep">
                    <HeaderedContentControl.Header>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AllProfiles}" Content="全选" FontSize="12" />
                            <TextBlock Text="用户" />
                        </DockPanel>
                    </HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="默认只勾选最近用过的用户" />
                        <Grid>
                            <TextBlock x:Name="ProfilesHint" Style="{StaticResource Hint}" Visibility="Collapsed" />
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Current}" Style="{StaticResource PlainList}"
                                     ItemContainerStyle="{StaticResource RowItem}" Margin="-12,0" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,8">
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                      ToolTip="带走这个用户" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                                       Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Key}" Style="{StaticResource Mono}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullTitle}"
                                                               HorizontalAlignment="Left" />
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastUsed}" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding Email}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               ToolTip="{Binding FullTitle}" HorizontalAlignment="Left" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </HeaderedContentControl>
            </Grid>

            <!-- 第 3、4 步编辑的是第 2 步选中的那个用户 -->
            <Grid Grid.Column="2" DataContext="{Binding Current}" IsEnabled="{Binding IsChecked}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- 内容 -->
            <HeaderedContentControl Style="{StaticResource StepCard}" Tag="3">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="内容" />
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock x:Name="ContentHint" Style="{StaticResource Hint}" Foreground="{StaticResource Danger}" Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <UniformGrid Columns="6">
                        <UniformGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ItemHint}">
                                <Setter Property="Margin" Value="22,2,0,0" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="None" />
                            </Style>
                        </UniformGrid.Resources>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeBookmarks}" Content="书签" />
                            <TextBlock Text="收藏的网页" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeHistory}" Content="历史记录" />
                            <TextBlock Text="浏览记录" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeSettings}" Content="浏览器设置" />
                            <TextBlock Text="主页、外观等" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeSiteData}" Content="网站设置" />
                            <TextBlock Text="各站偏好" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeSecrets}" Content="本机机密" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ItemHint}">
                                        <Setter Property="Margin" Value="22,2,0,0" />
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="TextTrimming" Value="None" />
                                        <Setter Property="Text" Value="密码和 Cookie" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IncludeSecrets}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.PortableBrowser, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="便携版可行" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IncludeSecrets}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.PortableBrowser, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="安装版无效" />
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeExtensions}" Content="扩展" />
                            <TextBlock Text="下一步选" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Background="{StaticResource Bg}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Hint}" Text="缓存和打开的标签页不会带走" />
                    </Border>
                </StackPanel>
            </HeaderedContentControl>

            <!-- 扩展 -->
            <HeaderedContentControl Grid.Row="2" Style="{StaticResource StepCard}" Tag="4" x:Name="ExtensionsStep"
                                    IsEnabled="{Binding IncludeExtensions}">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExtensionSummary}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" />
                        <DockPanel Margin="0,0,16,0">
                            <TextBlock DockPanel.Dock="Left" Text="扩展" />
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DockPanel>
                </HeaderedContentControl.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="数据是扩展的设置内容，勾了才带走" />
                    <Grid>
                        <TextBlock x:Name="ExtensionsHint" Style="{StaticResource Hint}" Visibility="Collapsed" />
                        <DockPanel x:Name="ExtensionsList">
                            <!-- 表头列宽和下面每行保持一致；最右一列让出滚动条的宽度，和主题里的 ScrollBarSize 一致 -->
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid TextElement.FontSize="12" TextElement.Foreground="{StaticResource Text2}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="8,6">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AllExtensions}" VerticalAlignment="Center"
                                                      ToolTip="勾选这个用户的全部扩展" />
                                            <TextBlock Text="名称" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6">
                                        <TextBlock Text="版本" />
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6">
                                        <TextBlock Text="状态" />
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6">
                                        <TextBlock Text="程序" HorizontalAlignment="Right" />
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,6">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IncludeExtensionData}" VerticalAlignment="Center"
                                                      ToolTip="勾上扩展时会带上数据，这里可以再逐条取消。扩展没勾选时，数据也不能勾" />
                                            <TextBlock Text="数据" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Visible">
                                <ItemsControl ItemsSource="{Binding Extensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="112" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Padding="8,7">
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="N" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Padding="8,7">
                                                        <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="2" Padding="8,7">
                                                        <TextBlock x:Name="S" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Text2}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="3" Padding="8,7">
                                                        <TextBlock Text="{Binding ProgramSize}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,7">
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IncludeData}" IsEnabled="{Binding IsChecked}"
                                                                      VerticalAlignment="Center" ToolTip="带上这个扩展自己存的设置和内容" />
                                                            <TextBlock Text="{Binding DataSize}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter TargetName="N" Property="Foreground" Value="{StaticResource Muted}" />
                                                    <Setter TargetName="S" Property="Foreground" Value="{StaticResource Muted}" />
                                                </DataTrigger>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </HeaderedContentControl>
            </Grid>

            <Grid Grid.Column="4" x:Name="PackColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- 打包 -->
            <HeaderedContentControl Style="{StaticResource StepCard}" Tag="5" Header="打包" Padding="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,8">
                        <CheckBox IsChecked="{Binding IncludeProgram}" Content="带上浏览器程序" />
                        <TextBlock Style="{StaticResource ItemHint}" Text="勾上后换台电脑解压就能用，不勾仅用户数据" />
                        <CheckBox IsChecked="{Binding AutoBackup}" Content="加入自动备份" />
                        <TextBlock Style="{StaticResource ItemHint}" Text="这个方案是否加入自动备份" Margin="24,2,0,0" />

                        <CheckBox Margin="0,20,0,8" Content="{Binding PasswordCaption}"
                                  IsChecked="{Binding RequirePassword}" IsEnabled="{Binding PasswordEditable}" />
                        <DockPanel Visibility="{Binding RequirePassword, Converter={StaticResource Vis}}">
                            <Button x:Name="RevealButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="显示" Margin="4,0,0,0"
                                    VerticalAlignment="Center" Click="OnReveal" />
                            <Grid>
                                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                                <TextBox x:Name="PasswordPlain" Visibility="Collapsed" FontFamily="{StaticResource MonoFont}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="忘了就解不开，请自己记好"
                                   Visibility="{Binding RequirePassword, Converter={StaticResource Vis}}" />

                        <TextBlock Text="打包格式" Style="{StaticResource Group}" />
                        <Border Background="{StaticResource SurfaceStep}" CornerRadius="8" Padding="3">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource Segment}" GroupName="archive" Content="自解压 exe"
                                             IsChecked="{Binding ArchiveFormat, Converter={StaticResource EnumMatch}, ConverterParameter=Sfx}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="archive" Content=".7z"
                                             IsChecked="{Binding ArchiveFormat, Converter={StaticResource EnumMatch}, ConverterParameter=SevenZip}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="archive" Content=".zip"
                                             IsChecked="{Binding ArchiveFormat, Converter={StaticResource EnumMatch}, ConverterParameter=Zip}" />
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="FormatHintText" Text="{Binding FormatHint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormatZip}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FormatHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel x:Name="ZipOptions" Margin="0,8,0,0" Visibility="{Binding FormatZip, Converter={StaticResource Vis}}">
                            <Border Background="{StaticResource SurfaceStep}" CornerRadius="8" Padding="3">
                                <UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="zip" Content="AES-256 加密"
                                                 IsChecked="{Binding ZipEncryption, Converter={StaticResource EnumMatch}, ConverterParameter=Aes256}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="zip" Content="传统加密"
                                                 IsChecked="{Binding ZipEncryption, Converter={StaticResource EnumMatch}, ConverterParameter=ZipCrypto}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="{Binding FormatHint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Setter Property="Margin" Value="0,6,0,4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FormatHintDanger}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Text="zip 密码只能用英文、数字和符号" />
                        </StackPanel>

                        <DockPanel Margin="0,20,0,8">
                            <Button DockPanel.Dock="Right" Content="默认" Style="{StaticResource LabelButton}" Click="OnResetNameTemplate" />
                            <TextBlock Text="文件名" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="TemplateBox" Text="{Binding NameTemplateText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" />
                        <WrapPanel x:Name="Variables" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding TemplateError}" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="前缀" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="英文方案名" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Slug, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding AsciiFileName}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox IsChecked="{Binding AsciiFileName}" Margin="0,12,0,0" Content="文件名只用英文" FontSize="12"
                                  HorizontalAlignment="Left" ToolTip="兼容不支持中文文件名的老 FTP" />
                    </StackPanel>
                </ScrollViewer>
            </HeaderedContentControl>

            <!-- 目的地 -->
            <HeaderedContentControl Grid.Row="2" Style="{StaticResource StepCard}" Tag="6" MaxHeight="300">
                <HeaderedContentControl.Header>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="管理目的地" Height="24" FontSize="12"
                                VerticalAlignment="Center" Click="OnManageTargets" />
                        <TextBlock Text="目的地" VerticalAlignment="Center" />
                    </DockPanel>
                </HeaderedContentControl.Header>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保留最近" VerticalAlignment="Center" Foreground="{StaticResource Text2}" />
                            <TextBox Text="{Binding KeepCount, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="8,0"
                                     VerticalAlignment="Center" HorizontalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="份" VerticalAlignment="Center" Foreground="{StaticResource Text2}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="更早的自动删除，填 0 全部保留。只删本程序传上去的文件" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource CheckRow}" />
                    </ScrollViewer>
                </DockPanel>
            </HeaderedContentControl>
            </Grid>
        </Grid>

        <!-- 行李牌：这次会打出什么 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <!-- 阴影只挂在牌的外形上。挂在整张牌上时，圆角按钮四角会按透明底抗锯齿，看起来脏 -->
            <Grid IsHitTestVisible="False">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#000000" />
                </Grid.Effect>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="M1,0 L1,1 L0,0.72 L0,0.28 Z" Stretch="Fill" Fill="{StaticResource Tag}" />
                <Border Grid.Column="1" Background="{StaticResource Tag}" CornerRadius="0,12,12,0" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Path Data="M1,0 L1,1 L0,0.72 L0,0.28 Z" Stretch="Fill" Fill="{StaticResource Tag}" IsHitTestVisible="False" />
            <Border Grid.Column="1" Background="{StaticResource Tag}" CornerRadius="0,12,12,0" Padding="0,14,20,14">
                <Grid x:Name="TagGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4*" MinWidth="400" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="14" Height="14" Fill="{StaticResource Bg}" Stroke="{StaticResource AccentHover}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="方案" Style="{StaticResource TagLabel}" />
                        <TextBlock x:Name="PlanNameText" Text="{Binding Name}" FontSize="18" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                   HorizontalAlignment="Left" ToolTip="{Binding Name}" />
                    </StackPanel>
                    <Line x:Name="StartLine" Grid.Column="2" Style="{StaticResource Perforation}" />
                    <!-- 两个大小并排，共用一段 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="未提取" Style="{StaticResource TagLabel}" />
                            <TextBlock x:Name="SizeText" Text="…" FontWeight="Normal" Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="提取后" Style="{StaticResource TagLabel}" HorizontalAlignment="Left"
                                       ToolTip="按当前打包格式和上次备份的压缩比估算" />
                            <TextBlock x:Name="PackedSizeText" Text="{Binding PackedSize}" FontWeight="Normal" Foreground="{StaticResource Text}" Margin="0,3,0,0"
                                       HorizontalAlignment="Left" ToolTip="按当前打包格式和上次备份的压缩比估算" />
                        </StackPanel>
                    </StackPanel>
                    <Line x:Name="ExtractLine" Grid.Column="4" Style="{StaticResource Perforation}" />
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Text="待打包" Style="{StaticResource TagLabel}" />
                        <ItemsControl x:Name="FileList" ItemsSource="{Binding FileNames}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 短名字时大小紧跟文件名；放不下时名字省略，大小留在可见区域里 -->
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.MaxWidth>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                     Converter="{StaticResource PositiveWidth}" />
                                        </Grid.MaxWidth>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{StaticResource Text2}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Line x:Name="PackLine" Grid.Column="6" Style="{StaticResource Perforation}"
                          Visibility="{Binding ShowDestination, Converter={StaticResource Vis}}" />
                    <!-- 这一列和待打包按 3:4 分剩余宽度，再窄也不小于 240。出错收起时不占这 240，按钮才不会被挤出屏幕 -->
                    <StackPanel x:Name="DestinationPanel" Grid.Column="7" VerticalAlignment="Center" MinWidth="240"
                                Visibility="{Binding ShowDestination, Converter={StaticResource Vis}}">
                        <TextBlock Text="目的地" Style="{StaticResource TagLabel}" />
                        <TextBlock x:Name="DestinationText" Text="{Binding Destinations}" Foreground="{StaticResource Text}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left" ToolTip="{Binding DestinationsDetail}">
                            <TextBlock.MaxWidth>
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=StackPanel}"
                                         Converter="{StaticResource PositiveWidth}" />
                            </TextBlock.MaxWidth>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="64,0,0,0">
                        <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Style="{StaticResource TagMessage}" Foreground="{StaticResource Danger}"
                                   MaxWidth="220" TextWrapping="Wrap" Margin="0,0,16,0"
                                   ToolTip="{Binding Problem}" />
                        <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="快速备份" Height="36" Padding="24,0"
                                VerticalAlignment="Center" Click="OnBackupNow" />
                        <Image Width="15" Height="15" Margin="10,0,0,0" VerticalAlignment="Center"
                               Source="pack://application:,,,/Assets/hint-info.png"
                               RenderOptions.BitmapScalingMode="HighQuality" ToolTipService.ShowDuration="30000">
                            <Image.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="使用说明&#10;过程：提取、打包、上传三个阶段&#10;快速：正常优先级、上传不限速，最快&#10;慢速：打包降优先级，上传按限速走，不影响使用" />
                                        <Border Height="1" Background="{StaticResource LineStrong}" Margin="0,5" />
                                        <TextBlock Text="本机文件夹是磁盘复制，不受限速影响&#10;自动备份时提取期间打开浏览器会打断，下次关闭时重试&#10;主页面固定快速，自动备份固定慢速，托盘菜单的备份可以自己选模式" />
                                    </StackPanel>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                    <!-- 飞机在文字上面。铺满整牌，飞出起终点的部分另做裁切 -->
                    <Canvas x:Name="PlaneLayer" Grid.ColumnSpan="9" IsHitTestVisible="False" Panel.ZIndex="1">
                        <Image x:Name="Plane" Height="32" Source="pack://application:,,,/Assets/plane.png"
                               RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Canvas>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
