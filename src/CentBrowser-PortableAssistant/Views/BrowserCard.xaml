<UserControl x:Class="CentBrowser_PortableAssistant.Views.BrowserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </UserControl.Resources>
    <!-- DataContext 是当前方案的 PlanEditor -->
    <StackPanel>
        <TextBlock Text="{Binding BrowserLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding BrowserPath}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text2}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="选择目录…" Click="OnPick" ToolTip="选 chrome.exe 所在的目录" />
            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="改回自动识别" Margin="0,0,8,0" Click="OnAutoDetect"
                    Visibility="{Binding IsManualBrowser, Converter={StaticResource Vis}}" />
        </DockPanel>
    </StackPanel>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBrowser}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
