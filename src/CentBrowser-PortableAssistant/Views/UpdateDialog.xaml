<Window x:Class="CentBrowser_PortableAssistant.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新版本" Width="560" Height="440" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" FontSize="15" TextWrapping="Wrap" />
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,10" CornerRadius="8"
                Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Text2}" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Hint}" FontSize="13" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="8,0,0,0" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
