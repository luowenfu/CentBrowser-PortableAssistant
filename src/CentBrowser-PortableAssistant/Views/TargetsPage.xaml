<UserControl x:Class="CentBrowser_PortableAssistant.Views.TargetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SectionHead" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StepHead}" />
            <Setter Property="CornerRadius" Value="11,11,0,0" />
        </Style>
        <!-- 内容区始终让出滚动条的宽度，条本身只在超出时出现，选 FTP 不会把字段挤一下 -->
        <Style x:Key="FormScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ScrollContentPresenter.Margin>
                                    <Thickness Left="0" Top="0" Bottom="0" Right="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                                </ScrollContentPresenter.Margin>
                            </ScrollContentPresenter>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Height="0" Visibility="Collapsed"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KindSegment" TargetType="ListBoxItem">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SectionCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <DockPanel Margin="16,12" MinHeight="24">
                        <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"
                                Height="24" FontSize="12" VerticalAlignment="Center" Click="OnAdd">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                <TextBlock Text="添加" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="目的地" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="备份先在本地打好包，再送到目的地" />
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"
                               Text="断网时留在本地，网络恢复后自动重传" />
                </StackPanel>
                <ListBox x:Name="TargetList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         Margin="8,8,8,8" SelectionChanged="OnSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock x:Name="Title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding KindLine}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=Editor}" Value="Hidden">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                        <DockPanel Margin="16,12" MinHeight="24">
                            <TextBlock Text="设置" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock Text="还没有目的地" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="在左边点添加" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="备份会先在本地打好包，再送到这里" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="Editor" Style="{StaticResource SectionCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                        <DockPanel Margin="16,12" MinHeight="24">
                            <TextBlock Text="设置" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Style="{StaticResource FormScroll}">
                        <StackPanel Margin="16,16,16,4">
                            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                            <Border Background="{StaticResource SurfaceStep}" CornerRadius="8" Padding="3">
                                <ListBox x:Name="KindBox" SelectionChanged="OnKindChanged"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{StaticResource Text2}"
                                         HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource KindSegment}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                            </Border>

                            <TextBlock Text="目的地名称" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <DockPanel>
                                <CheckBox x:Name="DisabledBox" DockPanel.Dock="Right" Content="停用" Margin="12,0,0,0"
                                          VerticalAlignment="Center" Checked="OnDisabledChanged" Unchecked="OnDisabledChanged" />
                                <TextBox x:Name="NameBox" />
                            </DockPanel>

                            <!-- 端口和加密方式只在 FTP 出现，贴在服务器右边；其他类型这两列不占位 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="AddressLabel" Text="地址" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择…" Margin="8,0,0,0" Click="OnBrowse" />
                                        <TextBox x:Name="AddressBox" FontFamily="{StaticResource MonoFont}" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel x:Name="PortPanel" Grid.Column="1" Width="72" Margin="16,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PortBox" FontFamily="{StaticResource MonoFont}" HorizontalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="SecurityPanel" Grid.Column="2" Margin="16,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="加密方式" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="SecurityBox" Width="148" SelectionChanged="OnKindChanged" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AddressHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />

                            <StackPanel x:Name="RemoteFields">
                                <StackPanel x:Name="DirPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="DirLabel" Text="远程目录" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DirBox" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock x:Name="DirHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="UserBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="PassBox" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="AuthHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="坚果云等网盘要填“应用密码”，不是登录密码" />

                                <CheckBox x:Name="AnyCertBox" Margin="0,12,0,0" Content="接受自签名证书（只在自己搭的服务器上打开）" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存" Click="OnSave" />
                                <Button x:Name="TestButton" Content="测试连接" Margin="8,0,0,0" Click="OnTest" />
                                <Button Style="{StaticResource DangerQuietButton}" Content="删除" Margin="16,0,0,0" Click="OnDelete" />
                            </StackPanel>
                            <TextBlock x:Name="StatusText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Text2}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
