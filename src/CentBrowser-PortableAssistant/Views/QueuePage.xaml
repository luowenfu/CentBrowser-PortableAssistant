<UserControl x:Class="CentBrowser_PortableAssistant.Views.QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CentBrowser_PortableAssistant.Controls"
             xmlns:v="clr-namespace:CentBrowser_PortableAssistant.Views"
             Background="{StaticResource Bg}">
    <UserControl.Resources>
        <v:PositiveWidthConverter x:Key="PositiveWidth" />
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SectionHead" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StepHead}" />
            <Setter Property="CornerRadius" Value="11,11,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 待上传：上面一块白卡片 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <DockPanel Margin="16,12">
                        <Button DockPanel.Dock="Right" Content="立即重试" Click="OnRetry" VerticalAlignment="Center"
                                x:Name="RetryButton" Visibility="Collapsed" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="待上传" FontSize="14" Foreground="{StaticResource Text}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" x:Name="Subtitle" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="没有待上传的文件" Foreground="{StaticResource Muted}" Margin="16,12" />
                    <ScrollViewer x:Name="JobScroll" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Jobs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,8,16,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Hover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="144" />
                                                <ColumnDefinition x:Name="NameCol" Width="*" />
                                                <ColumnDefinition Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding When}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Trigger}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Plan}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Plan}" />
                                            <c:FileTag Grid.Column="3" Text="{Binding FileName}" Size="{Binding Size}"
                                                       ToolTip="{Binding FileName}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <c:FileTag.MaxWidth>
                                                    <Binding Path="ActualWidth" ElementName="NameCol"
                                                             Converter="{StaticResource PositiveWidth}" />
                                                </c:FileTag.MaxWidth>
                                            </c:FileTag>
                                            <Button Grid.Column="4" Style="{StaticResource QuietButton}" Content="删除"
                                                    Tag="{Binding Id}" Click="OnRemove" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" FontSize="12"
                                                       Margin="0,8,0,0" TextWrapping="Wrap" x:Name="S"
                                                       Foreground="{StaticResource Text2}" />
                                            <ProgressBar Grid.Row="2" Grid.ColumnSpan="5" Value="{Binding Percent}" Height="4"
                                                         Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                         Foreground="{StaticResource Accent}" Background="{StaticResource SurfaceStep}"
                                                         BorderThickness="0" Visibility="{Binding ProgressVisibility}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="S" Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 备份记录：下面一块白卡片，灰底从中间露出来 -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHead}">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="备份记录" FontSize="14" Foreground="{StaticResource Text}" />
                        <TextBlock Text="超过保留份数后，目的地的旧文件将会被删除。记录保留最多 100 条" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="RecordEmpty" Text="还没有送达的备份" Foreground="{StaticResource Muted}"
                               Margin="16,12" VerticalAlignment="Top" />
                    <ScrollViewer x:Name="RecordScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Records" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,8,16,4" MinHeight="40">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Hover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="Auto" MaxWidth="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding When}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Trigger}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Plan}" Margin="12,0,0,0" MaxWidth="108"
                                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Plan}" />
                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="BackupPace" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeliveryStatus" />
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Files}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- 上下各留 2，文件之间仍隔 4。只留下边距时，速度会比这一行矮一截 -->
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="TagCol" Width="*" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="BackupPace" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DeliveryStatus" />
                                                            </Grid.ColumnDefinitions>
                                                            <c:FileTag Text="{Binding Name}" Size="{Binding Size}" ToolTip="{Binding Name}"
                                                                       Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <c:FileTag.MaxWidth>
                                                                    <Binding Path="ActualWidth" ElementName="TagCol"
                                                                             Converter="{StaticResource PositiveWidth}" />
                                                                </c:FileTag.MaxWidth>
                                                            </c:FileTag>
                                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Lines}" Margin="12,0,0,0"
                                                                          VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Text}" FontSize="12" ToolTip="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="NoWrap" HorizontalAlignment="Left"
                                                                                   Foreground="{StaticResource Text2}" x:Name="Line"
                                                                                   Loaded="OnStatusLoaded" SizeChanged="OnStatusSize" />
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                                <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Danger}" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="{Binding Pace}" FontSize="12" Margin="48,0,0,0"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                                           Foreground="{StaticResource Text2}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
