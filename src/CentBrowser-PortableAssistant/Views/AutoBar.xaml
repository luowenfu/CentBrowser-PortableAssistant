<UserControl x:Class="CentBrowser_PortableAssistant.Views.AutoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="12">
    <DockPanel Margin="20,0" MinHeight="52">
        <!-- 待上传 -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="13" Foreground="{StaticResource Text2}" />
            <TextBlock x:Name="QueueText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text2}" />
            <Button Style="{StaticResource QuietButton}" Content="查看" FontSize="12" Margin="8,0,0,0" Click="OnOpenQueue" />
        </StackPanel>

        <!-- 限速、开机启动、自动备份 -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 慢速上传限速。快速和本机文件夹不限，所以不跟着自动备份一起变灰 -->
            <ComboBox x:Name="LimitBox" Width="128" FontSize="12" Margin="0,0,24,0" SelectionChanged="OnLimitChanged" VerticalAlignment="Center"
                      ToolTip="慢速备份时的上传限速">
                <ComboBoxItem Content="不限速" />
                <ComboBoxItem Content="限速 512 KB/s" />
                <ComboBoxItem Content="限速 1 MB/s" />
                <ComboBoxItem Content="限速 2 MB/s" />
                <ComboBoxItem Content="限速 5 MB/s" />
            </ComboBox>
            <CheckBox x:Name="StartSwitch" Style="{StaticResource Switch}" Click="OnStartToggled" VerticalAlignment="Center" />
            <TextBlock Text="开机启动" Margin="8,0,0,0" VerticalAlignment="Center"
                       ToolTip="开机启动，常驻托盘" />

            <StackPanel x:Name="AutoPanel" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="AutoSwitch" Style="{StaticResource Switch}" Click="OnAutoToggled" VerticalAlignment="Center" />
                <TextBlock Text="自动备份" Margin="8,0,0,0" VerticalAlignment="Center"
                           ToolTip="关掉浏览器 2 分钟后自动备份（慢速）。勾选的用户内容没变化就跳过" />
                <ComboBox x:Name="FrequencyBox" Width="112" FontSize="12" Margin="12,0,0,0" SelectionChanged="OnFrequencyChanged" VerticalAlignment="Center"
                          ToolTip="多久备一次。每周按周一到周日">
                    <ComboBoxItem Content="每天一次" />
                    <ComboBoxItem Content="每周一次" />
                    <ComboBoxItem Content="每月一次" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- 备份状态在这段空白里居中。飞机从下面飞过，左右留一点，飞出的部分裁掉 -->
        <Grid>
            <Canvas x:Name="PlaneTrack" Margin="16,0" ClipToBounds="True" IsHitTestVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="OnPlaneTrackSize">
                <Image x:Name="Plane" Height="32" Source="pack://application:,,,/Assets/plane.png"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" IsHitTestVisible="False" />
            </Canvas>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="16,6"
                       Foreground="{StaticResource Text2}" />
        </Grid>
    </DockPanel>
</UserControl>
