<UserControl x:Class="CentBrowser_PortableAssistant.Controls.FileTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="24" HorizontalAlignment="Left">
    <!-- 行李牌：文件名后面跟一行灰色的大小。放不下时先省略文件名 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path Data="M1,0 L1,1 L0,0.72 L0,0.28 Z" Stretch="Fill" Fill="{StaticResource Tag}" />
        <Ellipse Width="5" Height="5" Fill="{StaticResource Bg}" Stroke="{StaticResource AccentHover}" StrokeThickness="1"
                 HorizontalAlignment="Left" Margin="5,0,0,0" />
        <Border Grid.Column="1" Background="{StaticResource Tag}" CornerRadius="0,6,6,0" Padding="2,0,10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text, ElementName=Root}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Size, ElementName=Root}" Margin="8,0,0,0"
                           FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Size, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Size, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
